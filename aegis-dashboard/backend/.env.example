# Database
# When running the backend outside Docker against the docker-compose Postgres,
# use host port 5433 (see docker-compose.yml). Inside Docker, use port 5432.
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5433/aegis_dashboard

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Keys
API_KEY_PREFIX=ak_

# CORS (the frontend dev server runs on port 3003)
CORS_ORIGINS=["http://localhost:3003"]

# Application
DEBUG=false
ENVIRONMENT=production
